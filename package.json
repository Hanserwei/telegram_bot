{
  "name": "telegram-video-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --test tests/setup.test.mjs && vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "setup:ids": "node scripts/telegram.mjs ids",
    "setup:webhook": "node scripts/telegram.mjs register",
    "setup:check": "node scripts/telegram.mjs check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261009.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
